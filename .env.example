# 邮件服务：当前支持 gmail
MAIL_PROVIDER=gmail
MAIL_FROM_NAME=Your Name | Your Company
MAIL_FROM_ADDRESS=your-account@gmail.com
MAIL_REPLY_TO=your-account@gmail.com

# Google OAuth 2.0 凭据
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token

# 外联发送控制
OUTREACH_DAILY_LIMIT=30
OUTREACH_TIMEZONE=Asia/Shanghai
OUTREACH_REQUIRE_REVIEW=false

# Gmail 推送/Webhook 验证密钥
MAIL_WEBHOOK_SECRET=replace-with-a-random-secret

# 实时买家搜索（仅服务端读取，不会发送到浏览器）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=qwen3.8-max

# 内网穿透时建议启用；设置后访问页面需要 HTTP Basic Auth
DEMO_ACCESS_USER=sales
DEMO_ACCESS_PASSWORD=replace-with-a-strong-password

# 预留付费海关/提单数据供应商密钥；未配置时只使用公开网页证据
CUSTOMS_API_KEY=
